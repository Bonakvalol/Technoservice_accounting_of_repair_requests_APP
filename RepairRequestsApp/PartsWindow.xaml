<Window x:Class="RepairRequestsApp.PartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запчасти" 
        Height="500" 
        Width="800"
        WindowStartupLocation="CenterOwner"
        FontFamily="Monotype Corsiva"
        Background="#FFFFFF">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#5EC6CD" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <TextBlock Text="Запчасти" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <DataGrid x:Name="DataGridParts" 
                  Grid.Row="1"
                  Background="#D2F1F0"
                  AlternatingRowBackground="#FFFFFF"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding PartNumber}" Width="120"/>
                <DataGridTextColumn Header="Название" Binding="{Binding PartName}" Width="200"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding QuantityInStock}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>