<Window x:Class="RepairRequestsApp.EquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оборудование" 
        Height="500" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        FontFamily="Monotype Corsiva"
        Background="#FFFFFF">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#5EC6CD" Padding="10" Margin="0,0,0,10" CornerRadius="5">
            <TextBlock Text="Оборудование" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <DataGrid x:Name="DataGridEquipment" 
                  Grid.Row="1"
                  Background="#D2F1F0"
                  AlternatingRowBackground="#FFFFFF"
                  AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Серийный номер" Binding="{Binding SerialNumber}" Width="150"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="150"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="150"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="200"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>